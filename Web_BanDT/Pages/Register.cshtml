@page
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="AURA PHONE - Tạo tài khoản" />
    <meta name="theme-color" content="#ffffff" />
    <title>AURA PHONE | Đăng ký</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --white: #ffffff;
            --bg: #fafafa;
            --bg-soft: #f4f4f5;
            --line: rgba(24, 24, 27, 0.10);
            --line-strong: rgba(24, 24, 27, 0.18);
            --text: #09090b;
            --text-soft: #52525b;
            --muted: #71717a;
            --muted-2: #a1a1a6;
            --glass: rgba(255,255,255,0.62);
            --glass-strong: rgba(255,255,255,0.8);
            --shadow-soft: 0 25px 70px rgba(0,0,0,0.08);
            --shadow-card: 0 26px 80px rgba(0,0,0,0.12);
            --error: #b42318;
            --error-soft: rgba(180, 35, 24, 0.08);
            --success: #1f7a4f;
            --radius-sm: 14px;
            --radius-md: 18px;
            --radius-lg: 26px;
            --radius-xl: 36px;
            --ease: cubic-bezier(.16, 1, .3, 1);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Inter", sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at top right, rgba(0,0,0,0.03), transparent 24%),
                linear-gradient(180deg, #ffffff 0%, #f7f7f8 35%, #f0f0f1 100%);
            -webkit-font-smoothing: antialiased;
            text-rendering: optimizeLegibility;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        img {
            display: block;
            max-width: 100%;
        }

        button,
        input {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        ::selection {
            background: rgba(0, 0, 0, 0.9);
            color: #fff;
        }

        .page-shell {
            min-height: 100vh;
            padding: 28px 24px 34px;
        }

        .topbar {
            width: min(1380px, 100%);
            margin: 0 auto 30px;
            padding: 18px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            border: 1px solid rgba(255,255,255,0.8);
            background: rgba(255,255,255,0.62);
            backdrop-filter: blur(24px) saturate(130%);
            -webkit-backdrop-filter: blur(24px) saturate(130%);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,0.9),
                0 18px 55px rgba(0,0,0,0.04);
            border-radius: 22px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-family: "Manrope", sans-serif;
            line-height: 1;
            letter-spacing: -0.08em;
            font-weight: 800;
            text-transform: uppercase;
        }

        .brand-mark {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 12px;
            background: #0f0f12;
            color: #fff;
            font-size: 18px;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.22);
        }

        .brand-name {
            display: flex;
            flex-direction: column;
            gap: 2px;
            font-size: 15px;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-soft);
            transition: color 0.2s ease, transform 0.2s ease;
        }

        .back-link:hover,
        .back-link:focus-visible {
            color: var(--text);
        }

        .back-link svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
            stroke-width: 1.8;
            fill: none;
            transition: transform 0.2s ease;
        }

        .back-link:hover svg,
        .back-link:focus-visible svg {
            transform: translateX(-2px);
        }

        .auth-layout {
            width: min(1380px, 100%);
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            gap: 28px;
            align-items: stretch;
        }

        .visual-panel,
        .auth-panel {
            position: relative;
            border-radius: var(--radius-xl);
            overflow: hidden;
        }

        .visual-panel {
            min-height: 760px;
            padding: 32px;
            border: 1px solid rgba(255,255,255,0.8);
            background:
                radial-gradient(circle at 22% 18%, rgba(0,0,0,0.08), transparent 22%),
                linear-gradient(180deg, rgba(255,255,255,0.7), rgba(244,244,245,0.92));
            box-shadow: var(--shadow-soft);
        }

        .panel-glow {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 35% 30%, rgba(255,255,255,0.9), rgba(255,255,255,0) 40%);
            pointer-events: none;
        }

        .visual-inner {
            position: relative;
            z-index: 1;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 18px;
        }

        .visual-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .mini-pill {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 14px;
            border: 1px solid rgba(0, 0, 0, 0.08);
            background: rgba(255,255,255,0.5);
            border-radius: 999px;
            color: var(--text-soft);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .mini-pill::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #111;
            box-shadow: 0 0 0 4px rgba(17,17,17,0.08);
        }

        .visual-copy {
            max-width: 520px;
            margin-top: 18px;
            padding-right: 18px;
        }

        .visual-brand {
            margin: 0 0 18px;
            font-family: "Manrope", sans-serif;
            font-size: clamp(44px, 5vw, 80px);
            line-height: 0.9;
            letter-spacing: -0.07em;
            font-weight: 800;
        }

        .visual-strap {
            display: inline-block;
            margin-top: 8px;
            font-size: 13px;
            font-weight: 700;
            color: var(--muted);
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }

        .visual-paragraph {
            margin: 18px 0 0;
            color: var(--text-soft);
            font-size: 17px;
            line-height: 1.8;
            max-width: 500px;
        }

        .phone-stage {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: flex-end;
            min-height: 360px;
            margin-top: 8px;
        }

        .phone-stage::before {
            content: "";
            position: absolute;
            width: min(460px, 72%);
            height: min(460px, 72%);
            border-radius: 50%;
            background: radial-gradient(circle, rgba(17,17,17,0.12), rgba(17,17,17,0) 66%);
            filter: blur(16px);
            transform: translateY(28px);
        }

        .phone-image {
            position: relative;
            z-index: 2;
            width: min(500px, 78%);
            height: auto;
            filter: drop-shadow(0 34px 34px rgba(0,0,0,0.18));
            animation: phoneFloat 6.5s ease-in-out infinite;
        }

        .floating-card {
            position: absolute;
            left: 18px;
            bottom: 34px;
            z-index: 3;
            min-width: 190px;
            padding: 16px 16px 14px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.8);
            background: rgba(255,255,255,0.66);
            backdrop-filter: blur(20px) saturate(130%);
            -webkit-backdrop-filter: blur(20px) saturate(130%);
            box-shadow: var(--shadow-soft);
            animation: glassFloat 7.5s ease-in-out infinite;
        }

        .floating-card .card-label {
            display: block;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .floating-card strong {
            display: block;
            margin-top: 10px;
            font-size: 22px;
            line-height: 1;
            letter-spacing: -0.06em;
            font-family: "Manrope", sans-serif;
        }

        .floating-card small {
            display: block;
            margin-top: 8px;
            font-size: 12px;
            color: var(--text-soft);
        }

        .auth-panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: rgba(255,255,255,0.16);
            border: 1px solid rgba(255,255,255,0.5);
        }

        .auth-card {
            width: min(100%, 500px);
            padding: 32px 28px;
            border-radius: 28px;
            border: 1px solid rgba(255,255,255,0.85);
            background: rgba(255,255,255,0.62);
            backdrop-filter: blur(24px) saturate(130%);
            -webkit-backdrop-filter: blur(24px) saturate(130%);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,0.9),
                0 25px 70px rgba(0,0,0,0.08);
            opacity: 0;
            transform: translateY(15px);
            animation: cardReveal 0.7s var(--ease) forwards;
        }

        .auth-header {
            margin-bottom: 24px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 8px 12px;
            border-radius: 999px;
            background: rgba(0,0,0,0.04);
            color: var(--text-soft);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        .eyebrow::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #111;
        }

        h1 {
            margin: 18px 0 8px;
            font-family: "Manrope", sans-serif;
            font-size: clamp(32px, 3vw, 46px);
            line-height: 1.1;
            letter-spacing: -0.06em;
            font-weight: 800;
        }

        .subheading {
            margin: 0;
            color: var(--text-soft);
            line-height: 1.7;
            font-size: 15px;
        }

        form {
            margin-top: 24px;
        }

        .field {
            margin-bottom: 18px;
        }

        .field label {
            display: inline-block;
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-soft);
        }

        .field-note {
            display: block;
            margin-top: 8px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.6;
        }

        .input-wrap {
            position: relative;
            display: flex;
            align-items: center;
            gap: 12px;
            height: 56px;
            padding: 0 16px;
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            background: rgba(255,255,255,0.72);
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }

        .input-wrap:focus-within {
            border-color: rgba(17,17,17,0.7);
            box-shadow: 0 0 0 4px rgba(17,17,17,0.04);
        }

        .input-wrap svg {
            width: 18px;
            height: 18px;
            stroke: var(--muted);
            fill: none;
            stroke-width: 1.9;
            flex-shrink: 0;
        }

        .input-wrap input {
            width: 100%;
            border: 0;
            outline: 0;
            background: transparent;
            padding: 0;
            color: var(--text);
            font-size: 15px;
        }

        .input-wrap input::placeholder {
            color: var(--muted-2);
        }

        .password-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            padding: 0;
            border: 0;
            background: transparent;
            border-radius: 10px;
            color: var(--muted);
            transition: background 0.2s ease, color 0.2s ease;
        }

        .password-toggle:hover,
        .password-toggle:focus-visible {
            background: rgba(17,17,17,0.04);
            color: var(--text);
            outline: none;
        }

        .password-toggle svg {
            width: 18px;
            height: 18px;
        }

        .password-meter {
            margin-top: 10px;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 8px;
        }

        .meter-bar {
            height: 6px;
            border-radius: 999px;
            background: rgba(0,0,0,0.08);
            transition: background 0.25s ease, box-shadow 0.25s ease;
        }

        .meter-bar.active {
            background: rgba(17,17,17,0.9);
            box-shadow: 0 0 0 3px rgba(17,17,17,0.05);
        }

        .password-strength {
            margin-top: 8px;
            color: var(--muted);
            font-size: 12px;
            min-height: 18px;
        }

        .terms {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin: 18px 0 16px;
            color: var(--text-soft);
            font-size: 13px;
            line-height: 1.6;
        }

        .terms input {
            width: 16px;
            height: 16px;
            margin-top: 2px;
            accent-color: #111;
            cursor: pointer;
        }

        .terms a {
            color: var(--text);
            font-weight: 700;
        }

        .primary-btn {
            width: 100%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 56px;
            border: 0;
            border-radius: 16px;
            background: #0e0e10;
            color: #fff;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            box-shadow: 0 18px 30px rgba(0,0,0,0.12);
            transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
        }

        .primary-btn:hover,
        .primary-btn:focus-visible {
            transform: translateY(-2px);
            box-shadow: 0 22px 34px rgba(0,0,0,0.16);
            outline: none;
        }

        .primary-btn:active {
            transform: translateY(0);
        }

        .alt-action {
            margin-top: 22px;
            text-align: center;
            color: var(--text-soft);
            font-size: 14px;
        }

        .alt-action a {
            color: var(--text);
            font-weight: 700;
        }

        .error-text {
            min-height: 18px;
            margin-top: 8px;
            font-size: 12px;
            color: var(--error);
            line-height: 1.5;
        }

        .input-wrap.invalid {
            border-color: rgba(180,35,24,0.5);
            background: rgba(255,255,255,0.7);
            box-shadow: 0 0 0 4px rgba(180,35,24,0.04);
        }

        .input-wrap.invalid svg {
            stroke: var(--error);
        }

        .security-note {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 10px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.6;
        }

        .security-note svg {
            width: 16px;
            height: 16px;
            stroke: var(--success);
            fill: none;
            stroke-width: 2;
        }

        .benefits-list {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
            margin-top: 20px;
        }

        .benefit-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 14px;
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 14px;
            background: rgba(255,255,255,0.42);
            color: var(--text-soft);
            font-size: 13px;
            font-weight: 600;
        }

        .benefit-item svg {
            width: 16px;
            height: 16px;
            stroke: #111;
            fill: none;
            stroke-width: 2;
        }

        @@keyframes phoneFloat {
            0%, 100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(-8px);
            }
        }

        @@keyframes glassFloat {
            0%, 100% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-8px);
            }
        }

        @@keyframes cardReveal {
            from {
                opacity: 0;
                transform: translateY(15px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 1024px) {
            .auth-layout {
                grid-template-columns: 1fr;
            }

            .visual-panel {
                min-height: 560px;
            }
        }

        @@media (max-width: 768px) {
            .page-shell {
                padding: 18px 12px 26px;
            }

            .topbar {
                padding: 14px 16px;
            }

            .brand-name {
                font-size: 12px;
            }

            .back-link {
                font-size: 12px;
            }

            .visual-panel,
            .auth-panel {
                border-radius: 24px;
            }

            .auth-card {
                padding: 24px 18px;
            }

            .visual-copy {
                padding-right: 0;
            }

            .benefits-list {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 520px) {
            .topbar {
                gap: 10px;
                padding: 12px 14px;
            }

            .brand {
                gap: 10px;
            }

            .brand-mark {
                width: 30px;
                height: 30px;
                border-radius: 10px;
                font-size: 14px;
            }

            .back-link {
                gap: 6px;
            }

            .floating-card {
                left: 14px;
                bottom: 18px;
                min-width: 170px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
</head>
<body>
    <div class="page-shell">
        <header class="topbar" aria-label="Header điều hướng">
            <a class="brand" asp-page="/Index" aria-label="AURA PHONE trang chủ">
                <span class="brand-mark">A</span>
                <span class="brand-name">
                    <span>AURA</span>
                    <span>PHONE</span>
                </span>
            </a>

            <a class="back-link" asp-page="/Index" aria-label="Trở về cửa hàng">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
                <span>Trở về cửa hàng</span>
            </a>
        </header>

        <main class="auth-layout" aria-label="Trang đăng ký">
            <section class="visual-panel" aria-label="Thông tin thương hiệu AURA PHONE">
                <div class="panel-glow"></div>

                <div class="visual-inner">
                    <div>
                        <div class="visual-top">
                            <span class="mini-pill">Member only</span>
                        </div>

                        <div class="visual-copy">
                            <div class="visual-brand">Join<br />AURA.</div>
                            <span class="visual-strap">Shop smarter.</span>
                            <p class="visual-paragraph">
                                Tạo tài khoản để lưu sản phẩm yêu thích, theo dõi đơn hàng và nhận ưu đãi thành viên
                                dành riêng cho khách hàng AURA PHONE.
                            </p>
                        </div>
                    </div>

                    <div class="phone-stage" aria-hidden="true">
                        <img class="phone-image" src="~/assets/phones/pixel-10.svg" alt="Pixel phone" />

                        <div class="floating-card">
                            <span class="card-label">Member perks</span>
                            <strong>Priority</strong>
                            <small>Hỗ trợ nhanh hơn và ưu đãi độc quyền.</small>
                        </div>
                    </div>
                </div>
            </section>

            <section class="auth-panel" aria-label="Form đăng ký">
                <div class="auth-card">
                    <div class="auth-header">
                        <span class="eyebrow">AURA CLUB</span>
                        <h1>Tạo tài khoản.</h1>
                        <p class="subheading">Đăng ký để mua sắm nhanh hơn và quản lý đơn hàng của bạn.</p>
                    </div>

                    <form id="registerForm" method="post" novalidate>
                        <div class="field">
                            <label for="fullName">Họ và tên</label>
                            <div class="input-wrap" data-for="fullName">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zm-7 9a7 7 0 0 1 14 0" /></svg>
                                <input id="fullName" name="fullName" type="text" placeholder="Nguyễn Văn A" autocomplete="name" aria-label="Họ và tên" required />
                            </div>
                            <div class="error-text" id="fullNameError" aria-live="polite"></div>
                        </div>

                        <div class="field">
                            <label for="registerEmail">Email</label>
                            <div class="input-wrap" data-for="registerEmail">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5h16v11H4zM4 7l8 6 8-6" /></svg>
                                <input id="registerEmail" name="registerEmail" type="email" placeholder="you@example.com" autocomplete="email" aria-label="Email" required />
                            </div>
                            <span class="field-note">Email sẽ được sử dụng để xác thực và quản lý đơn hàng.</span>
                            <div class="error-text" id="registerEmailError" aria-live="polite"></div>
                        </div>

                        <div class="field">
                            <label for="phone">Số điện thoại</label>
                            <div class="input-wrap" data-for="phone">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.7 4.5h3.1l1.1 4.1-2.2 1.9a13.2 13.2 0 0 0 7.4 7.4l1.9-2.2 4.1 1.1v3.1a2 2 0 0 1-2 2A16.5 16.5 0 0 1 4.7 6.5a2 2 0 0 1 2-2z" /></svg>
                                <input id="phone" name="phone" type="tel" placeholder="0912 345 678" autocomplete="tel" aria-label="Số điện thoại" required />
                            </div>
                            <div class="error-text" id="phoneError" aria-live="polite"></div>
                        </div>

                        <div class="field">
                            <label for="registerPassword">Mật khẩu</label>
                            <div class="input-wrap" data-for="registerPassword">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V7.8A5 5 0 0 1 12 3a5 5 0 0 1 5 4.8V10M6 10h12v10H6z" /></svg>
                                <input id="registerPassword" name="registerPassword" type="password" placeholder="Tạo mật khẩu" autocomplete="new-password" aria-label="Mật khẩu" required />
                                <button class="password-toggle" type="button" data-target="registerPassword" aria-label="Hiển thị mật khẩu" aria-pressed="false">
                                    <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12zm10 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" /></svg>
                                    <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true" style="display:none;"><path d="M3 3l18 18M10.6 10.6A3 3 0 0 0 13.4 13.4M9.1 5.6A10.7 10.7 0 0 1 12 5c6.5 0 10 7 10 7a17.3 17.3 0 0 1-4.2 5.2M6.2 6.2A15.7 15.7 0 0 0 2 12s3.5 7 10 7a10.6 10.6 0 0 0 5.5-1.6" /></svg>
                                </button>
                            </div>

                            <div class="password-meter" aria-label="Password strength indicator">
                                <span class="meter-bar" data-strength-bar="1"></span>
                                <span class="meter-bar" data-strength-bar="2"></span>
                                <span class="meter-bar" data-strength-bar="3"></span>
                            </div>
                            <div class="password-strength" id="passwordStrength" aria-live="polite">Yếu</div>
                            <div class="error-text" id="registerPasswordError" aria-live="polite"></div>
                        </div>

                        <div class="field">
                            <label for="confirmPassword">Xác nhận mật khẩu</label>
                            <div class="input-wrap" data-for="confirmPassword">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V7.8A5 5 0 0 1 12 3a5 5 0 0 1 5 4.8V10M6 10h12v10H6z" /></svg>
                                <input id="confirmPassword" name="confirmPassword" type="password" placeholder="Nhập lại mật khẩu" autocomplete="new-password" aria-label="Xác nhận mật khẩu" required />
                                <button class="password-toggle" type="button" data-target="confirmPassword" aria-label="Hiển thị mật khẩu xác nhận" aria-pressed="false">
                                    <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12zm10 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" /></svg>
                                    <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true" style="display:none;"><path d="M3 3l18 18M10.6 10.6A3 3 0 0 0 13.4 13.4M9.1 5.6A10.7 10.7 0 0 1 12 5c6.5 0 10 7 10 7a17.3 17.3 0 0 1-4.2 5.2M6.2 6.2A15.7 15.7 0 0 0 2 12s3.5 7 10 7a10.6 10.6 0 0 0 5.5-1.6" /></svg>
                                </button>
                            </div>
                            <div class="error-text" id="confirmPasswordError" aria-live="polite"></div>
                        </div>

                        <div class="security-note">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 12.5l3 3 7-7" /></svg>
                            <span>Mật khẩu phải bảo mật và được lưu trữ bởi backend sau khi tích hợp xác thực thực tế.</span>
                        </div>

                        <label class="terms" for="terms">
                            <input id="terms" name="terms" type="checkbox" required />
                            <span>
                                Tôi đồng ý với <a href="#">Điều khoản sử dụng</a> và <a href="#">Chính sách bảo mật</a>.
                            </span>
                        </label>
                        <div class="error-text" id="termsError" aria-live="polite"></div>

                        <button class="primary-btn" type="submit">Tạo tài khoản</button>

                        <div class="alt-action">
                            Đã có tài khoản?
                            <a asp-page="/Login">Đăng nhập</a>
                        </div>
                    </form>
                </div>
            </section>
        </main>
    </div>

    <script>
        (function () {
            const form = document.getElementById('registerForm');
            const fullNameInput = document.getElementById('fullName');
            const registerEmailInput = document.getElementById('registerEmail');
            const phoneInput = document.getElementById('phone');
            const passwordInput = document.getElementById('registerPassword');
            const confirmInput = document.getElementById('confirmPassword');
            const termsInput = document.getElementById('terms');

            const setFieldError = function (input, wrap, message) {
                const errorElement = document.getElementById(input.id + 'Error');
                if (errorElement) {
                    errorElement.textContent = message || '';
                }
                if (wrap) {
                    wrap.classList.toggle('invalid', Boolean(message));
                }
                input.setAttribute('aria-invalid', Boolean(message) ? 'true' : 'false');
            };

            const getStrengthState = function (password) {
                let score = 0;
                if (password.length >= 8) score += 1;
                if (/[A-Z]/.test(password)) score += 1;
                if (/[a-z]/.test(password)) score += 1;
                if (/\d/.test(password)) score += 1;
                if (/[^A-Za-z0-9]/.test(password)) score += 1;

                if (score <= 2) return { label: 'Yếu', level: 1 };
                if (score <= 4) return { label: 'Trung bình', level: 2 };
                return { label: 'Mạnh', level: 3 };
            };

            const updateStrength = function () {
                const value = passwordInput.value;
                const bars = document.querySelectorAll('[data-strength-bar]');
                const strength = getStrengthState(value);
                const strengthText = document.getElementById('passwordStrength');

                bars.forEach(function (bar) {
                    const index = Number(bar.getAttribute('data-strength-bar'));
                    bar.classList.toggle('active', index <= strength.level);
                });

                if (!value) {
                    strengthText.textContent = 'Yếu';
                    return;
                }

                strengthText.textContent = strength.label;
            };

            const validateFullName = function () {
                const value = fullNameInput.value.trim();
                if (!value) {
                    setFieldError(fullNameInput, document.querySelector('[data-for="fullName"]'), 'Họ và tên là bắt buộc.');
                    return false;
                }
                setFieldError(fullNameInput, document.querySelector('[data-for="fullName"]'), '');
                return true;
            };

            const validateRegisterEmail = function () {
                const value = registerEmailInput.value.trim();
                if (!value) {
                    setFieldError(registerEmailInput, document.querySelector('[data-for="registerEmail"]'), 'Email là bắt buộc.');
                    return false;
                }
                const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!emailPattern.test(value)) {
                    setFieldError(registerEmailInput, document.querySelector('[data-for="registerEmail"]'), 'Email không hợp lệ.');
                    return false;
                }
                setFieldError(registerEmailInput, document.querySelector('[data-for="registerEmail"]'), '');
                return true;
            };

            const validatePhone = function () {
                const value = phoneInput.value.trim();
                if (!value) {
                    setFieldError(phoneInput, document.querySelector('[data-for="phone"]'), 'Số điện thoại là bắt buộc.');
                    return false;
                }
                if (value.replace(/\D/g, '').length < 9) {
                    setFieldError(phoneInput, document.querySelector('[data-for="phone"]'), 'Số điện thoại không hợp lệ.');
                    return false;
                }
                setFieldError(phoneInput, document.querySelector('[data-for="phone"]'), '');
                return true;
            };

            const validatePassword = function () {
                const value = passwordInput.value;
                if (!value) {
                    setFieldError(passwordInput, document.querySelector('[data-for="registerPassword"]'), 'Mật khẩu là bắt buộc.');
                    return false;
                }
                if (value.length < 8) {
                    setFieldError(passwordInput, document.querySelector('[data-for="registerPassword"]'), 'Mật khẩu phải có ít nhất 8 ký tự.');
                    return false;
                }
                if (!/[A-Z]/.test(value) || !/[a-z]/.test(value) || !/\d/.test(value)) {
                    setFieldError(passwordInput, document.querySelector('[data-for="registerPassword"]'), 'Mật khẩu nên có chữ hoa, chữ thường và số.');
                    return false;
                }
                setFieldError(passwordInput, document.querySelector('[data-for="registerPassword"]'), '');
                return true;
            };

            const validateConfirmPassword = function () {
                const value = confirmInput.value;
                if (!value) {
                    setFieldError(confirmInput, document.querySelector('[data-for="confirmPassword"]'), 'Vui lòng xác nhận mật khẩu.');
                    return false;
                }
                if (value !== passwordInput.value) {
                    setFieldError(confirmInput, document.querySelector('[data-for="confirmPassword"]'), 'Mật khẩu xác nhận không khớp.');
                    return false;
                }
                setFieldError(confirmInput, document.querySelector('[data-for="confirmPassword"]'), '');
                return true;
            };

            const validateTerms = function () {
                const checked = termsInput.checked;
                const termsError = document.getElementById('termsError');
                termsError.textContent = checked ? '' : 'Bạn cần đồng ý với điều khoản trước khi tiếp tục.';
                return checked;
            };

            fullNameInput.addEventListener('input', validateFullName);
            registerEmailInput.addEventListener('input', validateRegisterEmail);
            phoneInput.addEventListener('input', validatePhone);
            passwordInput.addEventListener('input', function () {
                updateStrength();
                validatePassword();
                if (confirmInput.value.length > 0) {
                    validateConfirmPassword();
                }
            });
            confirmInput.addEventListener('input', validateConfirmPassword);
            termsInput.addEventListener('change', validateTerms);

            document.querySelectorAll('.password-toggle').forEach(function (button) {
                button.addEventListener('click', function () {
                    const targetId = button.getAttribute('data-target');
                    const input = document.getElementById(targetId);
                    const isPassword = input.type === 'password';

                    input.type = isPassword ? 'text' : 'password';
                    button.setAttribute('aria-pressed', String(isPassword));
                    button.setAttribute('aria-label', isPassword ? 'Ẩn mật khẩu' : 'Hiển thị mật khẩu');

                    const eyeOpen = button.querySelector('.eye-open');
                    const eyeClosed = button.querySelector('.eye-closed');

                    if (isPassword) {
                        eyeOpen.style.display = 'none';
                        eyeClosed.style.display = 'block';
                    } else {
                        eyeOpen.style.display = 'block';
                        eyeClosed.style.display = 'none';
                    }
                });
            });

            form.addEventListener('submit', function (event) {
                event.preventDefault();

                const validFullName = validateFullName();
                const validEmail = validateRegisterEmail();
                const validPhone = validatePhone();
                const validPassword = validatePassword();
                const validConfirm = validateConfirmPassword();
                const validTerms = validateTerms();

                if (validFullName && validEmail && validPhone && validPassword && validConfirm && validTerms) {
                    form.submit();
                }
            });
        })();
    </script>
</body>
</html>
