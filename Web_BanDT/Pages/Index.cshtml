@page
@model Web_BanDT.Pages.IndexModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="AURA PHONE - Cửa hàng điện thoại chính hãng đa thương hiệu" />
    <meta name="theme-color" content="#ffffff" />
    <title>AURA PHONE | Smartphone Store</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --bg: #f6f6f7;
            --surface: #ffffff;
            --surface-soft: #f0f0f2;
            --surface-dark: #0c0c0d;
            --surface-dark-2: #171719;
            --ink: #0a0a0b;
            --ink-2: #323236;
            --muted: #73757b;
            --muted-2: #9d9fa5;
            --line: rgba(10, 10, 11, .085);
            --line-dark: rgba(255, 255, 255, .11);
            --glass: rgba(255, 255, 255, .68);
            --glass-strong: rgba(255, 255, 255, .84);
            --shadow-sm: 0 10px 32px rgba(0, 0, 0, .055);
            --shadow-md: 0 22px 64px rgba(0, 0, 0, .10);
            --shadow-lg: 0 36px 110px rgba(0, 0, 0, .15);
            --radius-sm: 16px;
            --radius-md: 24px;
            --radius-lg: 32px;
            --radius-xl: 42px;
            --container: 1360px;
            --ease: cubic-bezier(.16, 1, .3, 1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 120px;
        }

        body {
            min-height: 100vh;
            overflow-x: hidden;
            font-family: "Inter", sans-serif;
            color: var(--ink);
            background:
                radial-gradient(circle at 0 0, rgba(0,0,0,.035), transparent 24%),
                radial-gradient(circle at 100% 28%, rgba(0,0,0,.025), transparent 20%),
                linear-gradient(180deg, #fff 0%, var(--bg) 62%, #f0f0f1 100%);
            -webkit-font-smoothing: antialiased;
            text-rendering: optimizeLegibility;
        }

        body.menu-open,
        body.search-open {
            overflow: hidden;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        img,
        video {
            display: block;
            max-width: 100%;
        }

        button,
        input {
            font: inherit;
        }

        button {
            border: 0;
            background: none;
            cursor: pointer;
        }

        ::selection {
            color: #fff;
            background: #111;
        }

        .container {
            width: min(var(--container), calc(100% - 48px));
            margin: 0 auto;
        }

        .section {
            padding: 84px 0;
        }

        .section-head {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 28px;
            margin-bottom: 34px;
        }

        .section-copy {
            max-width: 740px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #686a70;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .16em;
            text-transform: uppercase;
        }

        .eyebrow::before {
            content: "";
            width: 24px;
            height: 2px;
            border-radius: 999px;
            background: #111;
        }

        .section-title {
            margin-top: 12px;
            font-family: "Manrope", sans-serif;
            font-size: clamp(34px, 4vw, 58px);
            line-height: 1;
            font-weight: 750;
            letter-spacing: -.055em;
        }

        .section-description {
            max-width: 610px;
            margin-top: 15px;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.75;
        }

        .text-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
            color: #151516;
            font-size: 12px;
            font-weight: 700;
        }

        .text-link svg {
            width: 16px;
            height: 16px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            transition: transform .3s var(--ease);
        }

        .text-link:hover svg {
            transform: translateX(4px);
        }

        .glass {
            border: 1px solid rgba(255,255,255,.78);
            background: rgba(255,255,255,.60);
            backdrop-filter: blur(24px) saturate(130%);
            -webkit-backdrop-filter: blur(24px) saturate(130%);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,.94),
                0 18px 55px rgba(0,0,0,.075);
        }

        .reveal {
            opacity: 0;
            transform: translateY(24px);
            transition:
                opacity .75s var(--ease),
                transform .75s var(--ease);
        }

        .reveal.visible {
            opacity: 1;
            transform: none;
        }

        .delay-1 { transition-delay: .08s; }
        .delay-2 { transition-delay: .16s; }
        .delay-3 { transition-delay: .24s; }

        /* =========================================================
           TOP STRIP
        ========================================================= */
        .commerce-strip {
            position: relative;
            z-index: 1200;
            min-height: 35px;
            display: flex;
            align-items: center;
            color: #d9d9dc;
            background: #0a0a0b;
            font-size: 10px;
        }

        .commerce-strip-inner {
            width: min(var(--container), calc(100% - 48px));
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .strip-message,
        .strip-links {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .strip-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(255,255,255,.08);
        }

        .strip-links a {
            color: #aaaab0;
            transition: color .2s ease;
        }

        .strip-links a:hover {
            color: #fff;
        }

        /* =========================================================
           HEADER
        ========================================================= */
        .site-header {
            position: sticky;
            top: 0;
            z-index: 1100;
            padding: 14px 0 0;
            pointer-events: none;
        }

        .header-shell {
            width: min(var(--container), calc(100% - 40px));
            margin: 0 auto;
            pointer-events: auto;
        }

        .header-main {
            min-height: 72px;
            display: grid;
            grid-template-columns: auto minmax(280px, 1fr) auto;
            align-items: center;
            gap: 26px;
            padding: 0 18px;
            border-radius: 24px;
            transition: background .3s ease, box-shadow .3s ease, transform .3s var(--ease);
        }

        .site-header.scrolled .header-main {
            background: rgba(255,255,255,.82);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,.96),
                0 14px 48px rgba(0,0,0,.10);
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            min-width: 142px;
        }

        .brand-mark {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            color: #fff;
            background: linear-gradient(145deg, #2e2e31, #050505 72%);
            box-shadow:
                inset 0 1px 1px rgba(255,255,255,.25),
                0 10px 24px rgba(0,0,0,.18);
            font-family: "Manrope", sans-serif;
            font-size: 15px;
            font-weight: 800;
        }

        .brand-word {
            display: flex;
            flex-direction: column;
            line-height: 1;
        }

        .brand-name {
            font-family: "Manrope", sans-serif;
            font-size: 14px;
            font-weight: 800;
            letter-spacing: -.04em;
        }

        .brand-subtitle {
            margin-top: 4px;
            color: #9a9ca1;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: .14em;
        }

        .desktop-search {
            position: relative;
            max-width: 650px;
            width: 100%;
            margin: 0 auto;
        }

        .desktop-search svg {
            position: absolute;
            left: 17px;
            top: 50%;
            width: 18px;
            height: 18px;
            transform: translateY(-50%);
            fill: none;
            stroke: #62646a;
            stroke-width: 1.7;
        }

        .desktop-search input {
            width: 100%;
            height: 46px;
            padding: 0 92px 0 47px;
            border: 1px solid rgba(0,0,0,.075);
            border-radius: 999px;
            outline: none;
            color: #111;
            background: rgba(255,255,255,.66);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.9);
            font-size: 12px;
            transition: border-color .25s ease, box-shadow .25s ease, background .25s ease;
        }

        .desktop-search input:focus {
            border-color: rgba(0,0,0,.18);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(0,0,0,.04);
        }

        .search-shortcut {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            padding: 6px 9px;
            border: 1px solid rgba(0,0,0,.075);
            border-radius: 8px;
            color: #8d8f94;
            background: #f4f4f5;
            font-size: 9px;
            font-weight: 700;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .action-button {
            position: relative;
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            color: #19191b;
            transition: background .25s ease, transform .25s var(--ease);
        }

        .action-button:hover {
            background: rgba(0,0,0,.055);
            transform: translateY(-1px);
        }

        .action-button svg {
            width: 19px;
            height: 19px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.65;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .cart-count {
            position: absolute;
            top: 2px;
            right: 1px;
            min-width: 17px;
            height: 17px;
            display: grid;
            place-items: center;
            padding: 0 4px;
            border: 2px solid #fff;
            border-radius: 999px;
            color: #fff;
            background: #0a0a0b;
            font-size: 8px;
            font-weight: 800;
        }

        .cart-count.bump {
            animation: cartBump .42s var(--ease);
        }

        .menu-button {
            display: none;
        }

        .category-nav {
            position: relative;
            min-height: 49px;
            display: flex;
            align-items: stretch;
            justify-content: center;
            gap: 2px;
            margin-top: 8px;
            padding: 0 12px;
            border-radius: 18px;
            overflow: visible;
        }

        .nav-entry {
            position: static;
            display: flex;
            align-items: stretch;
        }

        .nav-trigger {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 0 13px;
            color: #66686e;
            white-space: nowrap;
            font-size: 11px;
            font-weight: 650;
            transition: color .25s ease, background .25s ease;
        }

        .nav-trigger::after {
            content: "";
            position: absolute;
            left: 50%;
            bottom: 5px;
            width: 15px;
            height: 2px;
            border-radius: 999px;
            background: #111;
            transform: translateX(-50%) scaleX(0);
            transition: transform .3s var(--ease);
        }

        .nav-trigger:hover,
        .nav-trigger.active,
        .nav-entry:focus-within > .nav-trigger,
        .nav-entry:hover > .nav-trigger {
            color: #0d0d0e;
        }

        .nav-trigger:hover::after,
        .nav-trigger.active::after,
        .nav-entry:focus-within > .nav-trigger::after,
        .nav-entry:hover > .nav-trigger::after {
            transform: translateX(-50%) scaleX(1);
        }

        .nav-chevron {
            width: 12px;
            height: 12px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
            transition: transform .28s var(--ease);
        }

        .nav-entry:hover .nav-chevron,
        .nav-entry:focus-within .nav-chevron {
            transform: rotate(180deg);
        }

        /* Full-width commerce mega menu. Padding-top bridges the hover gap. */
        .mega-menu {
            position: absolute;
            z-index: 1200;
            top: 100%;
            left: 0;
            width: 100%;
            padding-top: 9px;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: translateY(-8px) scale(.992);
            transform-origin: top center;
            transition: opacity .22s ease, visibility .22s ease, transform .28s var(--ease);
        }

        .nav-entry:hover .mega-menu,
        .nav-entry:focus-within .mega-menu {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateY(0) scale(1);
        }

        .mega-menu-panel {
            display: grid;
            grid-template-columns: 1.2fr .85fr .95fr .9fr 1.25fr;
            gap: 0;
            width: 100%;
            min-height: 286px;
            overflow: hidden;
            padding: 18px;
            border: 1px solid rgba(255,255,255,.82);
            border-radius: 24px;
            background:
                linear-gradient(145deg, rgba(255,255,255,.92), rgba(244,244,246,.78));
            backdrop-filter: blur(28px) saturate(135%);
            -webkit-backdrop-filter: blur(28px) saturate(135%);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,.96),
                0 28px 80px rgba(0,0,0,.14);
        }

        .mega-menu-compact {
            grid-template-columns: 1.25fr 1fr 1fr 1.35fr;
        }

        .mega-column {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 3px;
            min-width: 0;
            padding: 11px 20px;
            border-right: 1px solid rgba(0,0,0,.065);
        }

        .mega-menu-panel > .mega-column:nth-last-of-type(1) {
            border-right: 0;
        }

        .mega-column-primary {
            padding-left: 12px;
        }

        .mega-kicker {
            display: block;
            margin-bottom: 9px;
            color: #a0a2a7;
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .13em;
            text-transform: uppercase;
        }

        .mega-column > a {
            width: 100%;
            padding: 7px 0;
            color: #55575c;
            font-size: 10px;
            font-weight: 550;
            line-height: 1.35;
            transition: color .2s ease, transform .22s var(--ease);
        }

        .mega-column > a::after,
        .mega-feature::after {
            display: none !important;
        }

        .mega-column > a:hover,
        .mega-column > a:focus-visible {
            color: #050505;
            transform: translateX(3px);
        }

        .mega-brand {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .mega-brand strong {
            color: #111214;
            font-family: "Manrope", sans-serif;
            font-size: 12px;
            font-weight: 750;
            letter-spacing: -.025em;
        }

        .mega-brand span {
            color: #97999e;
            font-size: 8px;
            font-weight: 500;
        }

        .mega-feature {
            position: relative;
            min-height: 248px;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            align-self: center;
            overflow: hidden;
            padding: 23px;
            border: 1px solid rgba(0,0,0,.07);
            border-radius: 20px;
            background:
                radial-gradient(circle at 75% 20%, rgba(0,0,0,.12), transparent 35%),
                linear-gradient(145deg, #f5f5f6, #e7e7ea);
            color: #111;
            transition: transform .3s var(--ease), box-shadow .3s ease;
        }

        .mega-feature::before {
            content: "";
            position: absolute;
            width: 145px;
            height: 145px;
            top: -52px;
            right: -42px;
            border: 1px solid rgba(0,0,0,.08);
            border-radius: 50%;
            box-shadow: 0 0 0 26px rgba(0,0,0,.025), 0 0 0 52px rgba(0,0,0,.016);
        }

        .mega-feature:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 40px rgba(0,0,0,.09);
        }

        .mega-feature-dark {
            border-color: rgba(255,255,255,.10);
            background:
                radial-gradient(circle at 78% 18%, rgba(255,255,255,.16), transparent 34%),
                linear-gradient(145deg, #111113, #29292d);
            color: #fff;
        }

        .mega-feature-dark::before {
            border-color: rgba(255,255,255,.08);
            box-shadow: 0 0 0 26px rgba(255,255,255,.025), 0 0 0 52px rgba(255,255,255,.015);
        }

        .mega-feature-label {
            position: relative;
            z-index: 1;
            margin-bottom: auto;
            color: #8e9095;
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .13em;
            text-transform: uppercase;
        }

        .mega-feature-dark .mega-feature-label {
            color: #a6a7ac;
        }

        .mega-feature strong {
            position: relative;
            z-index: 1;
            margin-top: 50px;
            font-family: "Manrope", sans-serif;
            font-size: 21px;
            font-weight: 750;
            letter-spacing: -.045em;
        }

        .mega-feature > span:not(.mega-feature-label):not(.mega-feature-link) {
            position: relative;
            z-index: 1;
            margin-top: 7px;
            color: #73757a;
            font-size: 9px;
            line-height: 1.55;
        }

        .mega-feature-dark > span:not(.mega-feature-label):not(.mega-feature-link) {
            color: #afb0b5;
        }

        .mega-feature-link {
            position: relative;
            z-index: 1;
            margin-top: 16px;
            font-size: 9px;
            font-weight: 750;
        }

        /* =========================================================
           MOBILE MENU
        ========================================================= */
        .mobile-menu {
            position: fixed;
            inset: 0;
            z-index: 1500;
            padding: 110px 18px 30px;
            background: rgba(236,236,238,.78);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .3s ease, visibility .3s ease;
        }

        .mobile-menu.active {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        .mobile-menu-card {
            width: min(520px, 100%);
            margin: 0 auto;
            padding: 20px;
            border-radius: 28px;
            transform: translateY(-16px);
            transition: transform .4s var(--ease);
        }

        .mobile-menu.active .mobile-menu-card {
            transform: none;
        }

        .mobile-menu a {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 5px;
            border-bottom: 1px solid var(--line);
            font-family: "Manrope", sans-serif;
            font-size: 18px;
            font-weight: 650;
            letter-spacing: -.035em;
        }

        .mobile-menu a:last-child {
            border-bottom: 0;
        }

        /* =========================================================
           HERO COMMERCE
        ========================================================= */
        .hero-commerce {
            padding: 34px 0 26px;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.75fr) minmax(300px, .75fr);
            gap: 18px;
            align-items: stretch;
        }

        .hero-slider {
            position: relative;
            min-height: 575px;
            overflow: hidden;
            border-radius: 36px;
            background: #111;
            box-shadow: var(--shadow-md);
        }

        .hero-slide {
            position: absolute;
            inset: 0;
            display: grid;
            align-items: center;
            padding: 58px;
            opacity: 0;
            visibility: hidden;
            transform: scale(1.018);
            transition:
                opacity .75s ease,
                visibility .75s ease,
                transform 1s var(--ease);
        }

        .hero-slide.active {
            opacity: 1;
            visibility: visible;
            transform: scale(1);
        }

        .hero-media {
            position: absolute;
            inset: 0;
            overflow: hidden;
            background:
                radial-gradient(circle at 78% 32%, rgba(255,255,255,.22), transparent 30%),
                linear-gradient(135deg, #0b0b0c, #2a2a2e);
        }

        .hero-media::after {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(90deg, rgba(0,0,0,.78) 0%, rgba(0,0,0,.42) 42%, rgba(0,0,0,.06) 72%),
                linear-gradient(0deg, rgba(0,0,0,.20), transparent 45%);
            pointer-events: none;
        }

        .hero-media img,
        .hero-media video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .hero-media img {
            transition: transform 7s linear;
        }

        .hero-slide.active .hero-media img {
            transform: scale(1.045);
        }

        .hero-slide[data-fallback="light"] .hero-media {
            background:
                radial-gradient(circle at 75% 35%, rgba(0,0,0,.10), transparent 30%),
                linear-gradient(135deg, #f8f8f9, #d9d9dd);
        }

        .hero-slide[data-fallback="light"] .hero-media::after {
            background:
                linear-gradient(90deg, rgba(255,255,255,.96) 0%, rgba(255,255,255,.72) 45%, rgba(255,255,255,.10) 75%);
        }

        .hero-fallback-phone {
            position: absolute;
            z-index: 1;
            right: 7%;
            bottom: -4%;
            width: min(42%, 420px);
            max-height: 92%;
            object-fit: contain;
            filter: drop-shadow(0 38px 32px rgba(0,0,0,.20));
            pointer-events: none;
        }

        .hero-content {
            position: relative;
            z-index: 4;
            max-width: 560px;
        }

        .hero-kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 11px;
            border: 1px solid rgba(255,255,255,.16);
            border-radius: 999px;
            color: #dfdfe2;
            background: rgba(255,255,255,.08);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .14em;
            text-transform: uppercase;
        }

        .hero-slide[data-fallback="light"] .hero-kicker {
            color: #494a4f;
            border-color: rgba(0,0,0,.08);
            background: rgba(255,255,255,.60);
        }

        .hero-kicker-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: currentColor;
        }

        .hero-title {
            margin-top: 22px;
            max-width: 620px;
            color: #fff;
            font-family: "Manrope", sans-serif;
            font-size: clamp(48px, 5.8vw, 82px);
            line-height: .92;
            font-weight: 750;
            letter-spacing: -.075em;
        }

        .hero-slide[data-fallback="light"] .hero-title {
            color: #0a0a0b;
        }

        .hero-description {
            max-width: 490px;
            margin-top: 22px;
            color: #c4c4c8;
            font-size: 14px;
            line-height: 1.75;
        }

        .hero-slide[data-fallback="light"] .hero-description {
            color: #66686d;
        }

        .hero-price {
            margin-top: 18px;
            color: #fff;
            font-family: "Manrope", sans-serif;
            font-size: 19px;
            font-weight: 700;
            letter-spacing: -.035em;
        }

        .hero-slide[data-fallback="light"] .hero-price {
            color: #111;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 25px;
        }

        .btn {
            min-height: 48px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            padding: 0 20px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            transition:
                transform .3s var(--ease),
                box-shadow .3s ease,
                background .3s ease,
                color .3s ease;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        .btn-light {
            color: #111;
            background: #fff;
            box-shadow: 0 12px 28px rgba(0,0,0,.18);
        }

        .btn-dark {
            color: #fff;
            background: #0b0b0c;
            box-shadow: 0 12px 28px rgba(0,0,0,.18);
        }

        .btn-glass {
            color: #fff;
            border: 1px solid rgba(255,255,255,.18);
            background: rgba(255,255,255,.10);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .hero-slide[data-fallback="light"] .btn-glass {
            color: #111;
            border-color: rgba(0,0,0,.10);
            background: rgba(255,255,255,.62);
        }

        .hero-controller {
            position: absolute;
            z-index: 10;
            left: 28px;
            right: 28px;
            bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
        }

        .hero-dots {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 7px;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 999px;
            background: rgba(0,0,0,.22);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .hero-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: rgba(255,255,255,.38);
            transition: width .35s var(--ease), background .3s ease;
        }

        .hero-dot.active {
            width: 25px;
            border-radius: 999px;
            background: #fff;
        }

        .hero-arrows {
            display: flex;
            gap: 7px;
        }

        .hero-arrow {
            width: 40px;
            height: 40px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(255,255,255,.14);
            border-radius: 50%;
            color: #fff;
            background: rgba(0,0,0,.24);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            transition: transform .25s var(--ease), background .25s ease;
        }

        .hero-arrow:hover {
            transform: scale(1.06);
            background: rgba(0,0,0,.42);
        }

        .hero-arrow svg {
            width: 17px;
            height: 17px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
        }

        .hero-side {
            display: grid;
            grid-template-rows: 1fr 1fr;
            gap: 18px;
        }

        .side-promo {
            position: relative;
            min-height: 278px;
            overflow: hidden;
            padding: 30px;
            border-radius: 32px;
            box-shadow: var(--shadow-sm);
        }

        .side-promo.dark {
            color: #fff;
            background:
                radial-gradient(circle at 85% 18%, rgba(255,255,255,.15), transparent 28%),
                linear-gradient(145deg, #0b0b0c, #262629);
        }

        .side-promo.light {
            border: 1px solid rgba(0,0,0,.07);
            background:
                radial-gradient(circle at 90% 15%, rgba(0,0,0,.08), transparent 26%),
                linear-gradient(145deg, rgba(255,255,255,.96), rgba(232,232,234,.90));
        }

        .promo-label {
            color: #a5a6ab;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .14em;
            text-transform: uppercase;
        }

        .side-promo.dark .promo-label {
            color: #bdbdc2;
        }

        .side-promo h2 {
            max-width: 270px;
            margin-top: 12px;
            font-family: "Manrope", sans-serif;
            font-size: clamp(27px, 2.6vw, 40px);
            line-height: 1;
            letter-spacing: -.055em;
        }

        .side-promo p {
            max-width: 265px;
            margin-top: 12px;
            color: #77797f;
            font-size: 11px;
            line-height: 1.6;
        }

        .side-promo.dark p {
            color: #aaaab0;
        }

        .side-promo .text-link {
            margin-top: 20px;
        }

        .side-promo.dark .text-link {
            color: #fff;
        }

        .promo-orb {
            position: absolute;
            right: -42px;
            bottom: -62px;
            width: 190px;
            height: 190px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,.15);
            box-shadow:
                inset 0 0 50px rgba(255,255,255,.08),
                0 0 0 28px rgba(255,255,255,.025),
                0 0 0 58px rgba(255,255,255,.018);
        }

        .trade-device {
            position: absolute;
            right: 20px;
            bottom: -35px;
            width: 132px;
            transform: rotate(11deg);
            filter: drop-shadow(0 22px 22px rgba(0,0,0,.18));
        }

        /* =========================================================
           TRUST BAR
        ========================================================= */
        .trust-bar {
            padding: 16px 0 0;
        }

        .trust-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            border: 1px solid rgba(0,0,0,.065);
            border-radius: 24px;
            background: rgba(255,255,255,.68);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.94);
        }

        .trust-item {
            min-height: 76px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 20px;
            border-left: 1px solid var(--line);
        }

        .trust-item:first-child {
            border-left: 0;
        }

        .trust-icon {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            border-radius: 13px;
            color: #111;
            background: #f0f0f1;
        }

        .trust-icon svg {
            width: 18px;
            height: 18px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.6;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .trust-item strong {
            display: block;
            font-size: 11px;
            font-weight: 700;
        }

        .trust-item span {
            display: block;
            margin-top: 4px;
            color: var(--muted);
            font-size: 9px;
            line-height: 1.4;
        }

        /* =========================================================
           BRAND RAIL
        ========================================================= */
        .brand-section {
            padding: 72px 0 28px;
        }

        .brand-rail {
            display: grid;
            grid-template-columns: repeat(8, 1fr);
            gap: 10px;
        }

        .brand-chip {
            min-height: 78px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 14px;
            border: 1px solid rgba(0,0,0,.07);
            border-radius: 22px;
            color: #7a7c81;
            background: rgba(255,255,255,.78);
            font-family: "Manrope", sans-serif;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .04em;
            transition:
                color .3s ease,
                transform .35s var(--ease),
                box-shadow .35s ease,
                border-color .3s ease;
        }

        .brand-chip:hover {
            color: #0d0d0e;
            border-color: rgba(0,0,0,.13);
            transform: translateY(-4px);
            box-shadow: var(--shadow-sm);
        }

        /* =========================================================
           CATEGORY QUICK SHOP
        ========================================================= */
        .quick-shop {
            padding: 56px 0 86px;
        }

        .quick-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 14px;
        }

        .quick-card {
            min-height: 174px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px;
            border: 1px solid rgba(0,0,0,.07);
            border-radius: 26px;
            background:
                linear-gradient(145deg, rgba(255,255,255,.96), rgba(238,238,240,.88));
            box-shadow: inset 0 1px 0 rgba(255,255,255,.96);
            transition: transform .4s var(--ease), box-shadow .4s ease;
        }

        .quick-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-md);
        }

        .quick-icon {
            width: 44px;
            height: 44px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(0,0,0,.07);
            border-radius: 15px;
            background: rgba(255,255,255,.70);
        }

        .quick-icon svg {
            width: 21px;
            height: 21px;
            fill: none;
            stroke: #111;
            stroke-width: 1.55;
        }

        .quick-card h3 {
            margin-top: 18px;
            font-family: "Manrope", sans-serif;
            font-size: 17px;
            font-weight: 700;
            letter-spacing: -.035em;
        }

        .quick-card p {
            margin-top: 6px;
            color: var(--muted);
            font-size: 9px;
            line-height: 1.5;
        }

        /* =========================================================
           PRODUCT SYSTEM
        ========================================================= */
        .product-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            margin-bottom: 24px;
        }

        .filter-chips {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px;
        }

        .filter-chip {
            min-height: 38px;
            padding: 0 15px;
            border: 1px solid rgba(0,0,0,.075);
            border-radius: 999px;
            color: #686a70;
            background: rgba(255,255,255,.72);
            font-size: 10px;
            font-weight: 700;
            transition: all .25s ease;
        }

        .filter-chip:hover,
        .filter-chip.active {
            color: #fff;
            border-color: #111;
            background: #111;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
        }

        .product-card {
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(0,0,0,.07);
            border-radius: 28px;
            background: rgba(255,255,255,.92);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,.98),
                0 12px 36px rgba(0,0,0,.04);
            transition:
                transform .45s var(--ease),
                box-shadow .45s ease,
                border-color .35s ease;
        }

        .product-card.filtered-out {
            display: none;
        }

        .product-card:hover {
            border-color: rgba(0,0,0,.13);
            transform: translateY(-7px);
            box-shadow: 0 28px 70px rgba(0,0,0,.11);
        }

        .product-visual {
            position: relative;
            height: 320px;
            display: grid;
            place-items: center;
            overflow: hidden;
            background:
                radial-gradient(circle at 50% 42%, rgba(205,205,209,.62), rgba(244,244,245,.90) 47%, #fff 80%);
        }

        .product-visual::after {
            content: "";
            position: absolute;
            top: -20%;
            left: -80%;
            width: 45%;
            height: 140%;
            transform: rotate(18deg);
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.72), transparent);
            transition: left .85s var(--ease);
            pointer-events: none;
        }

        .product-card:hover .product-visual::after {
            left: 135%;
        }

        .product-visual img {
            position: relative;
            z-index: 2;
            width: 76%;
            height: 80%;
            object-fit: contain;
            filter: drop-shadow(0 22px 24px rgba(0,0,0,.11));
            transition: transform .55s var(--ease), filter .4s ease;
        }

        .product-card:hover .product-visual img {
            transform: scale(1.06) translateY(-5px);
            filter: drop-shadow(0 28px 30px rgba(0,0,0,.16));
        }

        .product-badge {
            position: absolute;
            z-index: 5;
            top: 14px;
            left: 14px;
            padding: 7px 10px;
            border: 1px solid rgba(255,255,255,.88);
            border-radius: 999px;
            color: #161617;
            background: rgba(255,255,255,.70);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .10em;
        }

        .favorite-button {
            position: absolute;
            z-index: 6;
            top: 13px;
            right: 13px;
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(255,255,255,.88);
            border-radius: 50%;
            color: #686a70;
            background: rgba(255,255,255,.68);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            transition: all .25s ease;
        }

        .favorite-button:hover,
        .favorite-button.active {
            color: #fff;
            background: #111;
        }

        .favorite-button svg {
            width: 17px;
            height: 17px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.7;
        }

        .favorite-button.active svg {
            fill: rgba(255,255,255,.16);
        }

        .product-info {
            padding: 21px;
        }

        .product-brand {
            color: #a0a2a7;
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .15em;
            text-transform: uppercase;
        }

        .product-name {
            margin-top: 7px;
            font-family: "Manrope", sans-serif;
            font-size: 17px;
            line-height: 1.2;
            font-weight: 700;
            letter-spacing: -.035em;
        }

        .product-variant {
            margin-top: 6px;
            min-height: 30px;
            color: var(--muted);
            font-size: 10px;
            line-height: 1.5;
        }

        .product-meta {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 7px;
            margin-top: 11px;
            color: #77797e;
            font-size: 9px;
            font-weight: 600;
        }

        .rating {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            color: #28282b;
        }

        .rating svg {
            width: 12px;
            height: 12px;
            fill: #111;
            stroke: #111;
            stroke-width: 1.2;
        }

        .meta-dot {
            width: 3px;
            height: 3px;
            border-radius: 50%;
            background: #c1c2c6;
        }

        .installment {
            padding: 4px 7px;
            border: 1px solid rgba(0,0,0,.07);
            border-radius: 999px;
            background: #f4f4f5;
        }

        .product-price-row {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 12px;
            margin-top: 18px;
        }

        .price-stack {
            min-width: 0;
        }

        .price-current {
            display: block;
            color: #0a0a0b;
            font-family: "Manrope", sans-serif;
            font-size: 16px;
            font-weight: 800;
            letter-spacing: -.035em;
        }

        .price-old {
            display: inline-block;
            margin-top: 4px;
            color: #aaacb1;
            font-size: 9px;
            text-decoration: line-through;
        }

        .discount-label {
            display: inline-flex;
            margin-left: 5px;
            padding: 3px 5px;
            border-radius: 6px;
            color: #3e3f43;
            background: #ededee;
            font-size: 8px;
            font-weight: 800;
        }

        .add-cart {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            flex-shrink: 0;
            border-radius: 50%;
            color: #fff;
            background: #111;
            box-shadow: 0 12px 24px rgba(0,0,0,.17);
            transition: transform .3s var(--ease), box-shadow .3s ease;
        }

        .add-cart:hover {
            transform: translateY(-3px) scale(1.04);
            box-shadow: 0 16px 30px rgba(0,0,0,.24);
        }

        .add-cart svg {
            width: 17px;
            height: 17px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* =========================================================
           PROMO MEDIA BANNER
        ========================================================= */
        .media-promo {
            padding: 20px 0 84px;
        }

        .media-promo-card {
            position: relative;
            min-height: 355px;
            overflow: hidden;
            display: grid;
            align-items: center;
            padding: 56px;
            border-radius: 38px;
            color: #fff;
            background: #0c0c0d;
            box-shadow: var(--shadow-lg);
        }

        .media-promo-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 78% 38%, rgba(255,255,255,.12), transparent 25%),
                linear-gradient(115deg, rgba(0,0,0,.82), rgba(0,0,0,.28) 60%, rgba(0,0,0,.08));
            z-index: 2;
        }

        .media-promo-bg {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: .48;
        }

        .media-promo-content {
            position: relative;
            z-index: 3;
            max-width: 570px;
        }

        .media-promo-content h2 {
            margin-top: 12px;
            font-family: "Manrope", sans-serif;
            font-size: clamp(38px, 5vw, 70px);
            line-height: .98;
            letter-spacing: -.065em;
        }

        .media-promo-content p {
            max-width: 470px;
            margin-top: 16px;
            color: #c0c0c5;
            font-size: 12px;
            line-height: 1.75;
        }

        /* =========================================================
           FLASH DEAL
        ========================================================= */
        .deal-section {
            padding: 84px 0;
            color: #fff;
            background:
                radial-gradient(circle at 10% 0, rgba(255,255,255,.08), transparent 22%),
                radial-gradient(circle at 90% 100%, rgba(255,255,255,.05), transparent 24%),
                #0a0a0b;
        }

        .deal-section .section-title,
        .deal-section .eyebrow {
            color: #fff;
        }

        .deal-section .eyebrow::before {
            background: #fff;
        }

        .deal-section .section-description {
            color: #a8a8ae;
        }

        .deal-head-right {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .countdown-label {
            margin-right: 5px;
            color: #999aa0;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .12em;
        }

        .time-box {
            min-width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(255,255,255,.10);
            border-radius: 13px;
            background: rgba(255,255,255,.06);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            font-family: "Manrope", sans-serif;
            font-size: 13px;
            font-weight: 700;
        }

        .deal-grid {
            display: grid;
            grid-template-columns: 1.1fr repeat(3, 1fr);
            gap: 15px;
        }

        .deal-lead,
        .deal-card {
            min-height: 330px;
            border: 1px solid rgba(255,255,255,.10);
            border-radius: 28px;
            background: rgba(255,255,255,.055);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        .deal-lead {
            position: relative;
            overflow: hidden;
            padding: 30px;
        }

        .deal-lead::after {
            content: "";
            position: absolute;
            width: 270px;
            height: 270px;
            right: -100px;
            bottom: -120px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,.10);
            box-shadow: 0 0 0 35px rgba(255,255,255,.025), 0 0 0 70px rgba(255,255,255,.018);
        }

        .deal-lead h3 {
            max-width: 300px;
            margin-top: 12px;
            font-family: "Manrope", sans-serif;
            font-size: 34px;
            line-height: 1;
            letter-spacing: -.05em;
        }

        .deal-lead p {
            max-width: 300px;
            margin-top: 14px;
            color: #a9aab0;
            font-size: 11px;
            line-height: 1.6;
        }

        .deal-card {
            display: flex;
            flex-direction: column;
            padding: 18px;
            transition: transform .35s var(--ease), background .3s ease;
        }

        .deal-card:hover {
            transform: translateY(-6px);
            background: rgba(255,255,255,.08);
        }

        .deal-card-image {
            height: 190px;
            display: grid;
            place-items: center;
            border-radius: 20px;
            background: rgba(255,255,255,.055);
        }

        .deal-card-image img {
            width: 74%;
            height: 82%;
            object-fit: contain;
            filter: drop-shadow(0 20px 20px rgba(0,0,0,.30));
        }

        .deal-card h4 {
            margin-top: 18px;
            font-family: "Manrope", sans-serif;
            font-size: 15px;
            letter-spacing: -.03em;
        }

        .deal-price {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 9px;
        }

        .deal-price strong {
            font-size: 13px;
        }

        .deal-price span {
            color: #818188;
            font-size: 9px;
            text-decoration: line-through;
        }

        /* =========================================================
           BRAND SPOTLIGHT
        ========================================================= */
        .spotlight-grid {
            display: grid;
            grid-template-columns: 1.2fr .8fr .8fr;
            gap: 16px;
        }

        .spotlight-card {
            position: relative;
            min-height: 410px;
            overflow: hidden;
            padding: 34px;
            border: 1px solid rgba(0,0,0,.07);
            border-radius: 32px;
            background:
                radial-gradient(circle at 82% 28%, rgba(0,0,0,.08), transparent 27%),
                linear-gradient(145deg, #fff, #e9e9eb);
            transition: transform .45s var(--ease), box-shadow .45s ease;
        }

        .spotlight-card.dark {
            color: #fff;
            border-color: rgba(255,255,255,.09);
            background:
                radial-gradient(circle at 82% 28%, rgba(255,255,255,.12), transparent 27%),
                linear-gradient(145deg, #0a0a0b, #27272a);
        }

        .spotlight-card:hover {
            transform: translateY(-7px);
            box-shadow: var(--shadow-md);
        }

        .spotlight-card h3 {
            max-width: 360px;
            margin-top: 10px;
            font-family: "Manrope", sans-serif;
            font-size: clamp(28px, 3vw, 44px);
            line-height: 1;
            letter-spacing: -.055em;
        }

        .spotlight-card p {
            max-width: 320px;
            margin-top: 12px;
            color: #77797f;
            font-size: 11px;
            line-height: 1.65;
        }

        .spotlight-card.dark p {
            color: #aaaab0;
        }

        .spotlight-phone {
            position: absolute;
            right: -15px;
            bottom: -30px;
            width: 62%;
            max-height: 300px;
            object-fit: contain;
            filter: drop-shadow(0 28px 28px rgba(0,0,0,.18));
        }

        /* =========================================================
           CONSULT / SERVICES
        ========================================================= */
        .consult-card {
            display: grid;
            grid-template-columns: 1.15fr .85fr;
            overflow: hidden;
            border: 1px solid rgba(0,0,0,.07);
            border-radius: 36px;
            background: rgba(255,255,255,.82);
            box-shadow: var(--shadow-sm);
        }

        .consult-content {
            padding: 55px;
        }

        .consult-content h2 {
            max-width: 620px;
            margin-top: 12px;
            font-family: "Manrope", sans-serif;
            font-size: clamp(36px, 4.4vw, 62px);
            line-height: .98;
            letter-spacing: -.06em;
        }

        .consult-content p {
            max-width: 510px;
            margin-top: 16px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.75;
        }

        .consult-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
            margin-top: 24px;
        }

        .consult-side {
            position: relative;
            min-height: 350px;
            overflow: hidden;
            background:
                radial-gradient(circle at 50% 50%, rgba(255,255,255,.16), transparent 30%),
                linear-gradient(145deg, #111, #2b2b2e);
        }

        .consult-side::before,
        .consult-side::after {
            content: "";
            position: absolute;
            border: 1px solid rgba(255,255,255,.10);
            border-radius: 50%;
        }

        .consult-side::before {
            width: 260px;
            height: 260px;
            right: -70px;
            top: -80px;
        }

        .consult-side::after {
            width: 190px;
            height: 190px;
            left: -60px;
            bottom: -80px;
        }

        .consult-glass {
            position: absolute;
            inset: 50% auto auto 50%;
            width: min(310px, 78%);
            padding: 24px;
            border: 1px solid rgba(255,255,255,.15);
            border-radius: 26px;
            transform: translate(-50%, -50%);
            color: #fff;
            background: rgba(255,255,255,.08);
            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.12);
        }

        .consult-glass strong {
            display: block;
            font-family: "Manrope", sans-serif;
            font-size: 24px;
            letter-spacing: -.04em;
        }

        .consult-glass span {
            display: block;
            margin-top: 7px;
            color: #b4b4ba;
            font-size: 10px;
            line-height: 1.6;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            margin-top: 18px;
            border: 1px solid rgba(0,0,0,.07);
            border-radius: 28px;
            background: rgba(255,255,255,.68);
            overflow: hidden;
        }

        .service-item {
            min-height: 155px;
            padding: 26px;
            border-left: 1px solid var(--line);
        }

        .service-item:first-child {
            border-left: 0;
        }

        .service-icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(0,0,0,.07);
            border-radius: 14px;
            background: #f1f1f2;
        }

        .service-icon svg {
            width: 19px;
            height: 19px;
            fill: none;
            stroke: #111;
            stroke-width: 1.55;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .service-item h3 {
            margin-top: 15px;
            font-size: 12px;
            font-weight: 700;
        }

        .service-item p {
            margin-top: 6px;
            color: var(--muted);
            font-size: 9px;
            line-height: 1.55;
        }

        /* =========================================================
           FOOTER
        ========================================================= */
        footer {
            margin-top: 84px;
            padding: 68px 0 24px;
            color: #d5d5d8;
            background: #09090a;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 1.7fr repeat(4, 1fr);
            gap: 42px;
            padding-bottom: 52px;
        }

        footer .brand-name {
            color: #fff;
        }

        footer .brand-mark {
            border: 1px solid rgba(255,255,255,.12);
        }

        .footer-copy {
            max-width: 330px;
            margin-top: 18px;
            color: #818188;
            font-size: 10px;
            line-height: 1.75;
        }

        .footer-column {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .footer-column h4 {
            margin-bottom: 4px;
            color: #fff;
            font-size: 10px;
            font-weight: 700;
        }

        .footer-column a {
            width: fit-content;
            color: #888990;
            font-size: 9px;
            transition: color .2s ease, transform .2s var(--ease);
        }

        .footer-column a:hover {
            color: #fff;
            transform: translateX(3px);
        }

        .footer-bottom {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,.08);
            color: #67686e;
            font-size: 8px;
        }

        .footer-legal {
            display: flex;
            gap: 18px;
        }

        /* =========================================================
           SEARCH OVERLAY
        ========================================================= */
        .search-overlay {
            position: fixed;
            inset: 0;
            z-index: 1800;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 120px 20px 40px;
            background: rgba(232,232,234,.76);
            backdrop-filter: blur(32px);
            -webkit-backdrop-filter: blur(32px);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .3s ease, visibility .3s ease;
        }

        .search-overlay.active {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
        }

        .search-panel {
            width: min(820px, 100%);
            padding: 28px;
            border-radius: 30px;
            transform: translateY(-18px) scale(.985);
            transition: transform .4s var(--ease);
        }

        .search-overlay.active .search-panel {
            transform: none;
        }

        .search-panel-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .search-panel-top span {
            color: #85878d;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .13em;
            text-transform: uppercase;
        }

        .close-search {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: #f0f0f1;
        }

        .close-search svg {
            width: 16px;
            height: 16px;
            fill: none;
            stroke: #111;
            stroke-width: 1.7;
        }

        .overlay-search-field {
            position: relative;
            margin-top: 18px;
        }

        .overlay-search-field svg {
            position: absolute;
            left: 0;
            bottom: 18px;
            width: 24px;
            height: 24px;
            fill: none;
            stroke: #111;
            stroke-width: 1.5;
        }

        .overlay-search-field input {
            width: 100%;
            padding: 10px 0 16px 38px;
            border: 0;
            border-bottom: 1px solid rgba(0,0,0,.12);
            outline: none;
            background: transparent;
            font-family: "Manrope", sans-serif;
            font-size: clamp(28px, 4.8vw, 52px);
            font-weight: 650;
            letter-spacing: -.05em;
        }

        .search-suggestions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 23px;
        }

        .search-suggestion {
            padding: 9px 13px;
            border: 1px solid rgba(0,0,0,.07);
            border-radius: 999px;
            color: #55575d;
            background: rgba(255,255,255,.72);
            font-size: 9px;
            font-weight: 600;
        }

        .search-suggestion:hover {
            color: #fff;
            background: #111;
        }

        /* =========================================================
           ANIMATION
        ========================================================= */
        @@keyframes cartBump {
            0%, 100% { transform: scale(1); }
            45% { transform: scale(1.35); }
        }

        @@keyframes floatSoft {
            0%, 100% { transform: translateY(0) rotate(11deg); }
            50% { transform: translateY(-10px) rotate(8deg); }
        }

        .trade-device {
            animation: floatSoft 6s ease-in-out infinite;
        }

        /* =========================================================
           RESPONSIVE
        ========================================================= */
        @@media (max-width: 1180px) {
            .header-main {
                grid-template-columns: auto 1fr auto;
            }

            .category-nav {
                justify-content: center;
                gap: 0;
                padding-inline: 7px;
                overflow: visible;
            }

            .nav-trigger {
                padding-inline: 9px;
                font-size: 10px;
            }

            .mega-menu-panel {
                grid-template-columns: 1.1fr .85fr .9fr .9fr 1.1fr;
                padding: 14px;
            }

            .mega-menu-compact {
                grid-template-columns: 1.2fr 1fr 1fr 1.2fr;
            }

            .mega-column {
                padding-inline: 14px;
            }

            .hero-grid {
                grid-template-columns: 1fr;
            }

            .hero-side {
                grid-template-columns: 1fr 1fr;
                grid-template-rows: auto;
            }

            .brand-rail {
                grid-template-columns: repeat(4, 1fr);
            }

            .quick-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .product-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .deal-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .spotlight-grid {
                grid-template-columns: 1fr 1fr;
            }

            .spotlight-card:first-child {
                grid-column: 1 / -1;
            }
        }

        @@media (max-width: 900px) {
            .commerce-strip-inner {
                justify-content: center;
            }

            .strip-links {
                display: none;
            }

            .header-main {
                min-height: 64px;
                grid-template-columns: auto 1fr auto;
                gap: 12px;
                padding: 0 12px;
            }

            .desktop-search {
                display: none;
            }

            .header-actions {
                justify-self: end;
            }

            .menu-button {
                display: grid;
            }

            .category-nav {
                display: none;
            }

            .hero-slider {
                min-height: 540px;
            }

            .hero-slide {
                padding: 44px 34px 76px;
            }

            .hero-content {
                max-width: 520px;
            }

            .hero-title {
                max-width: 520px;
                font-size: clamp(46px, 9vw, 68px);
            }

            .hero-fallback-phone {
                width: 45%;
                opacity: .72;
            }

            .trust-grid {
                grid-template-columns: 1fr 1fr;
            }

            .trust-item:nth-child(3) {
                border-left: 0;
                border-top: 1px solid var(--line);
            }

            .trust-item:nth-child(4) {
                border-top: 1px solid var(--line);
            }

            .product-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .consult-card {
                grid-template-columns: 1fr;
            }

            .consult-side {
                min-height: 300px;
            }

            .services-grid {
                grid-template-columns: 1fr 1fr;
            }

            .service-item:nth-child(3) {
                border-left: 0;
                border-top: 1px solid var(--line);
            }

            .service-item:nth-child(4) {
                border-top: 1px solid var(--line);
            }

            .footer-grid {
                grid-template-columns: 1.4fr 1fr 1fr;
            }

            .footer-brand {
                grid-column: 1 / -1;
            }
        }

        @@media (max-width: 680px) {
            .container,
            .commerce-strip-inner {
                width: min(100% - 28px, var(--container));
            }

            .header-shell {
                width: calc(100% - 20px);
            }

            .brand-word {
                display: none;
            }

            .brand {
                min-width: auto;
            }

            .commerce-strip {
                min-height: 31px;
            }

            .strip-message {
                font-size: 9px;
            }

            .hero-commerce {
                padding-top: 20px;
            }

            .hero-slider {
                min-height: 520px;
                border-radius: 28px;
            }

            .hero-slide {
                padding: 32px 24px 78px;
                align-items: flex-start;
                padding-top: 60px;
            }

            .hero-title {
                font-size: 46px;
            }

            .hero-description {
                max-width: 350px;
                font-size: 12px;
            }

            .hero-fallback-phone {
                width: 55%;
                right: -7%;
                bottom: -2%;
                opacity: .42;
            }

            .hero-controller {
                left: 20px;
                right: 20px;
                bottom: 18px;
            }

            .hero-side {
                grid-template-columns: 1fr;
            }

            .side-promo {
                min-height: 240px;
                border-radius: 27px;
            }

            .trust-grid {
                grid-template-columns: 1fr;
            }

            .trust-item,
            .trust-item:nth-child(2),
            .trust-item:nth-child(3),
            .trust-item:nth-child(4) {
                border-left: 0;
                border-top: 1px solid var(--line);
            }

            .trust-item:first-child {
                border-top: 0;
            }

            .section {
                padding: 66px 0;
            }

            .section-head {
                align-items: flex-start;
                flex-direction: column;
                margin-bottom: 27px;
            }

            .section-title {
                font-size: 38px;
            }

            .brand-section {
                padding-top: 58px;
            }

            .brand-rail {
                grid-template-columns: repeat(2, 1fr);
            }

            .brand-chip {
                min-height: 66px;
            }

            .quick-grid {
                grid-template-columns: 1fr 1fr;
            }

            .quick-card {
                min-height: 155px;
                padding: 17px;
            }

            .product-toolbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .product-grid {
                grid-template-columns: 1fr;
            }

            .product-visual {
                height: 340px;
            }

            .media-promo-card {
                min-height: 390px;
                padding: 34px 24px;
                border-radius: 28px;
            }

            .deal-head-right {
                flex-wrap: wrap;
            }

            .deal-grid {
                grid-template-columns: 1fr;
            }

            .spotlight-grid {
                grid-template-columns: 1fr;
            }

            .spotlight-card:first-child {
                grid-column: auto;
            }

            .spotlight-card {
                min-height: 360px;
            }

            .consult-content {
                padding: 38px 24px;
            }

            .services-grid {
                grid-template-columns: 1fr;
            }

            .service-item,
            .service-item:nth-child(2),
            .service-item:nth-child(3),
            .service-item:nth-child(4) {
                border-left: 0;
                border-top: 1px solid var(--line);
            }

            .service-item:first-child {
                border-top: 0;
            }

            .footer-grid {
                grid-template-columns: 1fr 1fr;
                gap: 32px 20px;
            }

            .footer-brand {
                grid-column: 1 / -1;
            }

            .footer-bottom {
                align-items: flex-start;
                flex-direction: column;
            }

            .footer-legal {
                flex-wrap: wrap;
                gap: 10px 15px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: .01ms !important;
                scroll-behavior: auto !important;
            }

            .reveal {
                opacity: 1;
                transform: none;
            }
        }

        :focus-visible {
            outline: 2px solid #111;
            outline-offset: 4px;
        }
    </style>
</head>
<body>
    <!-- TOP COMMERCIAL STRIP -->
    <div class="commerce-strip">
        <div class="commerce-strip-inner">
            <div class="strip-message">
                <span class="strip-dot"></span>
                <span>Miễn phí giao hàng toàn quốc cho đơn từ 1.000.000₫</span>
            </div>

            <div class="strip-links">
                <a href="#">Tra cứu đơn hàng</a>
                <a href="#">Hệ thống cửa hàng</a>
                <a href="#support">Hỗ trợ</a>
            </div>
        </div>
    </div>

    <!-- HEADER -->
    <header class="site-header" id="header">
        <div class="header-shell">
            <div class="header-main glass">
                <a href="#home" class="brand" aria-label="AURA PHONE - Trang chủ">
                    <span class="brand-mark">A</span>
                    <span class="brand-word">
                        <span class="brand-name">AURA</span>
                        <span class="brand-subtitle">PHONE STORE</span>
                    </span>
                </a>

                <div class="desktop-search">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="11" cy="11" r="7"></circle>
                        <path d="M20 20L16.4 16.4"></path>
                    </svg>
                    <input id="desktopSearchInput" type="search" placeholder="Tìm iPhone, Samsung, Xiaomi, Pixel..." autocomplete="off" aria-label="Tìm kiếm sản phẩm" />
                    <span class="search-shortcut">Enter</span>
                </div>

                <div class="header-actions">
                    <button class="action-button" id="searchButton" type="button" aria-label="Mở tìm kiếm" aria-expanded="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="M20 20L16.4 16.4"></path>
                        </svg>
                    </button>

                    <a asp-page="/Login" class="action-button" aria-label="Đăng nhập tài khoản" title="Đăng nhập">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="8" r="4"></circle>
                            <path d="M4.5 21C5.2 16.8 8 14.5 12 14.5C16 14.5 18.8 16.8 19.5 21"></path>
                        </svg>
                    </a>

                    <a href="#" class="action-button" aria-label="Giỏ hàng">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 5H6L8 16H18L20 8H7"></path>
                            <circle cx="9" cy="19" r="1.5"></circle>
                            <circle cx="17" cy="19" r="1.5"></circle>
                        </svg>
                        <span class="cart-count" id="cartCount">0</span>
                    </a>

                    <button class="action-button menu-button" id="menuButton" type="button" aria-label="Mở menu" aria-expanded="false">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M4 7H20"></path>
                            <path d="M4 12H20"></path>
                            <path d="M4 17H20"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <nav class="category-nav glass" aria-label="Danh mục chính">
                <div class="nav-entry nav-entry-home">
                    <a href="#home" class="nav-trigger active">Trang chủ</a>
                </div>

                <div class="nav-entry">
                    <a href="#products" class="nav-trigger" aria-haspopup="true">
                        Điện thoại
                        <svg class="nav-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9L12 14L17 9"></path></svg>
                    </a>
                    <div class="mega-menu" role="group" aria-label="Danh mục điện thoại">
                        <div class="mega-menu-panel">
                            <div class="mega-column mega-column-primary">
                                <span class="mega-kicker">Theo thương hiệu</span>
                                <a href="#products" class="mega-brand" data-brand-jump="apple"><strong>Apple</strong><span>iPhone & hệ sinh thái Apple</span></a>
                                <a href="#products" class="mega-brand" data-brand-jump="samsung"><strong>Samsung</strong><span>Galaxy S, Z, A Series</span></a>
                                <a href="#products" class="mega-brand" data-brand-jump="xiaomi"><strong>Xiaomi</strong><span>Flagship & hiệu năng cao</span></a>
                                <a href="#products" class="mega-brand" data-brand-jump="google"><strong>Google</strong><span>Pixel & AI Phone</span></a>
                            </div>

                            <div class="mega-column">
                                <span class="mega-kicker">Apple</span>
                                <a href="#products" data-search-jump="iPhone 17 Pro Max">iPhone 17 Pro Max</a>
                                <a href="#products" data-search-jump="iPhone 17">iPhone 17</a>
                                <a href="#products" data-search-jump="iPhone">Tất cả iPhone</a>
                                <a href="#products">iPhone giá tốt</a>
                            </div>

                            <div class="mega-column">
                                <span class="mega-kicker">Android nổi bật</span>
                                <a href="#products" data-search-jump="Galaxy S26 Ultra">Galaxy S26 Ultra</a>
                                <a href="#products" data-search-jump="Xiaomi 15 Ultra">Xiaomi 15 Ultra</a>
                                <a href="#products" data-search-jump="Pixel 10 Pro">Pixel 10 Pro</a>
                                <a href="#products">OPPO Find Series</a>
                            </div>

                            <div class="mega-column">
                                <span class="mega-kicker">Mua theo nhu cầu</span>
                                <a href="#products">Flagship cao cấp</a>
                                <a href="#products">Camera phone</a>
                                <a href="#products">Gaming phone</a>
                                <a href="#deals">Điện thoại giá tốt</a>
                            </div>

                            <a class="mega-feature" href="#new-arrivals">
                                <span class="mega-feature-label">New generation</span>
                                <strong>Smartphone mới</strong>
                                <span>Khám phá những mẫu máy vừa cập nhật.</span>
                                <span class="mega-feature-link">Xem sản phẩm mới →</span>
                            </a>
                        </div>
