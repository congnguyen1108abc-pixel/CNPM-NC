@page
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="AURA PHONE - Đăng nhập tài khoản" />
    <meta name="theme-color" content="#ffffff" />
    <title>AURA PHONE | Đăng nhập</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <style>
        :root {
            --white: #ffffff;
            --bg: #fafafa;
            --bg-soft: #f4f4f5;
            --line: rgba(24, 24, 27, 0.10);
            --line-strong: rgba(24, 24, 27, 0.18);
            --text: #09090b;
            --text-soft: #52525b;
            --muted: #71717a;
            --muted-2: #a1a1a6;
            --glass: rgba(255,255,255,0.62);
            --glass-strong: rgba(255,255,255,0.8);
            --shadow-soft: 0 25px 70px rgba(0,0,0,0.08);
            --shadow-card: 0 26px 80px rgba(0,0,0,0.12);
            --error: #b42318;
            --error-soft: rgba(180, 35, 24, 0.08);
            --success: #1f7a4f;
            --radius-sm: 14px;
            --radius-md: 18px;
            --radius-lg: 26px;
            --radius-xl: 36px;
            --ease: cubic-bezier(.16, 1, .3, 1);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Inter", sans-serif;
            color: var(--text);
            background:
                radial-gradient(circle at top left, rgba(0,0,0,0.03), transparent 28%),
                linear-gradient(180deg, #ffffff 0%, #f7f7f8 35%, #f0f0f1 100%);
            -webkit-font-smoothing: antialiased;
            text-rendering: optimizeLegibility;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        img {
            display: block;
            max-width: 100%;
        }

        button,
        input {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        ::selection {
            background: rgba(0, 0, 0, 0.9);
            color: #fff;
        }

        .page-shell {
            min-height: 100vh;
            padding: 28px 24px 34px;
        }

        .topbar {
            width: min(1380px, 100%);
            margin: 0 auto 30px;
            padding: 18px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            border: 1px solid rgba(255,255,255,0.8);
            background: rgba(255,255,255,0.62);
            backdrop-filter: blur(24px) saturate(130%);
            -webkit-backdrop-filter: blur(24px) saturate(130%);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,0.9),
                0 18px 55px rgba(0,0,0,0.04);
            border-radius: 22px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-family: "Manrope", sans-serif;
            line-height: 1;
            letter-spacing: -0.08em;
            font-weight: 800;
            text-transform: uppercase;
        }

        .brand-mark {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 12px;
            background: #0f0f12;
            color: #fff;
            font-size: 18px;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.22);
        }

        .brand-name {
            display: flex;
            flex-direction: column;
            gap: 2px;
            font-size: 15px;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-soft);
            transition: color 0.2s ease, transform 0.2s ease;
        }

        .back-link:hover,
        .back-link:focus-visible {
            color: var(--text);
        }

        .back-link svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
            stroke-width: 1.8;
            fill: none;
            transition: transform 0.2s ease;
        }

        .back-link:hover svg,
        .back-link:focus-visible svg {
            transform: translateX(-2px);
        }

        .auth-layout {
            width: min(1380px, 100%);
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.05fr 0.95fr;
            gap: 28px;
            align-items: stretch;
        }

        .visual-panel,
        .auth-panel {
            position: relative;
            border-radius: var(--radius-xl);
            overflow: hidden;
        }

        .visual-panel {
            min-height: 760px;
            padding: 32px;
            border: 1px solid rgba(255,255,255,0.8);
            background:
                radial-gradient(circle at 22% 18%, rgba(0,0,0,0.08), transparent 22%),
                linear-gradient(180deg, rgba(255,255,255,0.7), rgba(244,244,245,0.92));
            box-shadow: var(--shadow-soft);
        }

        .panel-glow {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 50% 42%, rgba(255,255,255,0.9), rgba(255,255,255,0) 38%);
            pointer-events: none;
        }

        .visual-inner {
            position: relative;
            z-index: 1;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 22px;
        }

        .visual-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .mini-pill {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 14px;
            border: 1px solid rgba(0, 0, 0, 0.08);
            background: rgba(255,255,255,0.5);
            border-radius: 999px;
            color: var(--text-soft);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .mini-pill::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #111;
            box-shadow: 0 0 0 4px rgba(17,17,17,0.08);
        }

        .visual-copy {
            max-width: 520px;
            margin-top: 18px;
            padding-right: 18px;
        }

        .visual-brand {
            margin: 0 0 18px;
            font-family: "Manrope", sans-serif;
            font-size: clamp(42px, 5vw, 80px);
            line-height: 0.9;
            letter-spacing: -0.07em;
            font-weight: 800;
        }

        .visual-strap {
            display: inline-block;
            margin-top: 8px;
            font-size: 13px;
            font-weight: 700;
            color: var(--muted);
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }

        .visual-paragraph {
            margin: 18px 0 0;
            color: var(--text-soft);
            font-size: 17px;
            line-height: 1.8;
            max-width: 500px;
        }

        .store-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            margin-top: 22px;
        }

        .badge {
            min-width: 150px;
            padding: 14px 18px;
            border-radius: 18px;
            border: 1px solid rgba(255,255,255,0.7);
            background: rgba(255,255,255,0.54);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.9);
            color: var(--text-soft);
            font-size: 13px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .badge svg {
            width: 20px;
            height: 20px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
        }

        .phone-stage {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: flex-end;
            min-height: 360px;
            margin-top: 8px;
        }

        .phone-stage::before {
            content: "";
            position: absolute;
            width: min(460px, 72%);
            height: min(460px, 72%);
            border-radius: 50%;
            background: radial-gradient(circle, rgba(17,17,17,0.12), rgba(17,17,17,0) 66%);
            filter: blur(16px);
            transform: translateY(28px);
        }

        .phone-image {
            position: relative;
            z-index: 2;
            width: min(500px, 78%);
            height: auto;
            filter: drop-shadow(0 34px 34px rgba(0,0,0,0.18));
            animation: phoneFloat 6.5s ease-in-out infinite;
        }

        .floating-card {
            position: absolute;
            right: 22px;
            bottom: 34px;
            z-index: 2;
            min-width: 190px;
            padding: 16px 16px 14px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.8);
            background: rgba(255,255,255,0.66);
            backdrop-filter: blur(20px) saturate(130%);
            -webkit-backdrop-filter: blur(20px) saturate(130%);
            box-shadow: var(--shadow-soft);
            animation: glassFloat 7.5s ease-in-out infinite;
        }

        .floating-card .card-label {
            display: block;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .floating-card strong {
            display: block;
            margin-top: 10px;
            font-size: 22px;
            line-height: 1;
            letter-spacing: -0.06em;
            font-family: "Manrope", sans-serif;
        }

        .floating-card small {
            display: block;
            margin-top: 8px;
            font-size: 12px;
            color: var(--text-soft);
        }

        .auth-panel {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: rgba(255,255,255,0.16);
            border: 1px solid rgba(255,255,255,0.5);
        }

        .auth-card {
            width: min(100%, 500px);
            padding: 32px 28px;
            border-radius: 28px;
            border: 1px solid rgba(255,255,255,0.85);
            background: rgba(255,255,255,0.62);
            backdrop-filter: blur(24px) saturate(130%);
            -webkit-backdrop-filter: blur(24px) saturate(130%);
            box-shadow:
                inset 0 1px 0 rgba(255,255,255,0.9),
                0 25px 70px rgba(0,0,0,0.08);
            opacity: 0;
            transform: translateY(15px);
            animation: cardReveal 0.7s var(--ease) forwards;
        }

        .auth-header {
            margin-bottom: 24px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 8px 12px;
            border-radius: 999px;
            background: rgba(0,0,0,0.04);
            color: var(--text-soft);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        .eyebrow::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #111;
        }

        h1 {
            margin: 18px 0 8px;
            font-family: "Manrope", sans-serif;
            font-size: clamp(32px, 3vw, 46px);
            line-height: 1.1;
            letter-spacing: -0.06em;
            font-weight: 800;
        }

        .subheading {
            margin: 0;
            color: var(--text-soft);
            line-height: 1.7;
            font-size: 15px;
        }

        form {
            margin-top: 24px;
        }

        .field {
            margin-bottom: 18px;
        }

        .field label {
            display: inline-block;
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-soft);
        }

        .input-wrap {
            position: relative;
            display: flex;
            align-items: center;
            gap: 12px;
            height: 56px;
            padding: 0 16px;
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
            background: rgba(255,255,255,0.72);
            transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        }

        .input-wrap:focus-within {
            border-color: rgba(17,17,17,0.7);
            box-shadow: 0 0 0 4px rgba(17,17,17,0.04);
        }

        .input-wrap svg {
            width: 18px;
            height: 18px;
            stroke: var(--muted);
            fill: none;
            stroke-width: 1.9;
            flex-shrink: 0;
        }

        .input-wrap input {
            width: 100%;
            border: 0;
            outline: 0;
            background: transparent;
            padding: 0;
            color: var(--text);
            font-size: 15px;
        }

        .input-wrap input::placeholder {
            color: var(--muted-2);
        }

        .password-toggle {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            padding: 0;
            border: 0;
            background: transparent;
            border-radius: 10px;
            color: var(--muted);
            transition: background 0.2s ease, color 0.2s ease;
        }

        .password-toggle:hover,
        .password-toggle:focus-visible {
            background: rgba(17,17,17,0.04);
            color: var(--text);
            outline: none;
        }

        .password-toggle svg {
            width: 18px;
            height: 18px;
        }

        .helper-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            margin-bottom: 12px;
        }

        .remember {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--text-soft);
            font-size: 13px;
            font-weight: 500;
            user-select: none;
        }

        .remember input {
            width: 16px;
            height: 16px;
            accent-color: #111;
            cursor: pointer;
        }

        .meta-link {
            color: var(--text-soft);
            font-size: 13px;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        .meta-link:hover,
        .meta-link:focus-visible {
            color: var(--text);
        }

        .primary-btn {
            width: 100%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 56px;
            border: 0;
            border-radius: 16px;
            background: #0e0e10;
            color: #fff;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            box-shadow: 0 18px 30px rgba(0,0,0,0.12);
            transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
        }

        .primary-btn:hover,
        .primary-btn:focus-visible {
            transform: translateY(-2px);
            box-shadow: 0 22px 34px rgba(0,0,0,0.16);
            outline: none;
        }

        .primary-btn:active {
            transform: translateY(0);
        }

        .divider {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 20px 0 18px;
            color: var(--muted);
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.12em;
        }

        .divider::before,
        .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: rgba(0,0,0,0.08);
        }

        .divider span {
            padding: 0 14px;
            background: rgba(255,255,255,0.16);
        }

        .secondary-btn {
            width: 100%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-height: 52px;
            border: 1px solid rgba(0,0,0,0.08);
            background: rgba(255,255,255,0.52);
            border-radius: 14px;
            color: var(--text-soft);
            font-size: 14px;
            font-weight: 600;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }

        .secondary-btn:hover,
        .secondary-btn:focus-visible {
            transform: translateY(-2px);
            border-color: rgba(0,0,0,0.14);
            outline: none;
        }

        .secondary-btn svg {
            width: 18px;
            height: 18px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.9;
        }

        .alt-action {
            margin-top: 22px;
            text-align: center;
            color: var(--text-soft);
            font-size: 14px;
        }

        .alt-action a {
            color: var(--text);
            font-weight: 700;
        }

        .error-text {
            min-height: 18px;
            margin-top: 8px;
            font-size: 12px;
            color: var(--error);
            line-height: 1.5;
        }

        .input-wrap.invalid {
            border-color: rgba(180,35,24,0.5);
            background: rgba(255,255,255,0.7);
            box-shadow: 0 0 0 4px rgba(180,35,24,0.04);
        }

        .input-wrap.invalid svg {
            stroke: var(--error);
        }

        .security-note {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 10px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.6;
        }

        .security-note svg {
            width: 16px;
            height: 16px;
            stroke: var(--success);
            fill: none;
            stroke-width: 2;
        }

        .benefits-list {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
            margin-top: 20px;
        }

        .benefit-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 14px;
            border: 1px solid rgba(0,0,0,0.06);
            border-radius: 14px;
            background: rgba(255,255,255,0.42);
            color: var(--text-soft);
            font-size: 13px;
            font-weight: 600;
        }

        .benefit-item svg {
            width: 16px;
            height: 16px;
            stroke: #111;
            fill: none;
            stroke-width: 2;
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        @@keyframes phoneFloat {
            0%, 100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(-8px);
            }
        }

        @@keyframes glassFloat {
            0%, 100% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-8px);
            }
        }

        @@keyframes cardReveal {
            from {
                opacity: 0;
                transform: translateY(15px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 1024px) {
            .auth-layout {
                grid-template-columns: 1fr;
            }

            .visual-panel {
                min-height: 560px;
            }
        }

        @@media (max-width: 768px) {
            .page-shell {
                padding: 18px 12px 26px;
            }

            .topbar {
                padding: 14px 16px;
            }

            .brand-name {
                font-size: 12px;
            }

            .back-link {
                font-size: 12px;
            }

            .visual-panel,
            .auth-panel {
                border-radius: 24px;
            }

            .auth-card {
                padding: 24px 18px;
            }

            .visual-copy {
                padding-right: 0;
            }

            .benefits-list {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 520px) {
            .topbar {
                gap: 10px;
                padding: 12px 14px;
            }

            .brand {
                gap: 10px;
            }

            .brand-mark {
                width: 30px;
                height: 30px;
                border-radius: 10px;
                font-size: 14px;
            }

            .back-link {
                gap: 6px;
            }

            .floating-card {
                right: 14px;
                bottom: 18px;
                min-width: 170px;
            }

            .helper-row {
                align-items: flex-start;
                flex-direction: column;
            }

            .remember {
                font-size: 12px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
</head>
<body>
    <div class="page-shell">
        <header class="topbar" aria-label="Header điều hướng">
            <a class="brand" asp-page="/Index" aria-label="AURA PHONE trang chủ">
                <span class="brand-mark">A</span>
                <span class="brand-name">
                    <span>AURA</span>
                    <span>PHONE</span>
                </span>
            </a>

            <a class="back-link" asp-page="/Index" aria-label="Trở về cửa hàng">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
                <span>Trở về cửa hàng</span>
            </a>
        </header>

        <main class="auth-layout" aria-label="Trang đăng nhập">
            <section class="visual-panel" aria-label="Thông tin thương hiệu AURA PHONE">
                <div class="panel-glow"></div>

                <div class="visual-inner">
                    <div>
                        <div class="visual-top">
                            <span class="mini-pill">Premium tech</span>
                        </div>

                        <div class="visual-copy">
                            <div class="visual-brand">AURA<br />PHONE</div>
                            <span class="visual-strap">Technology. Refined.</span>
                            <p class="visual-paragraph">
                                Khám phá smartphone chính hãng từ những thương hiệu công nghệ hàng đầu với trải
                                nghiệm mua sắm tối giản và đáng tin cậy.
                            </p>

                            <div class="store-badges" aria-label="Lợi ích cửa hàng">
                                <div class="badge">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 12.5l3 3 7-7" /></svg>
                                    <span>100% Chính hãng</span>
                                </div>
                                <div class="badge">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 12.5l3 3 7-7" /></svg>
                                    <span>Bảo hành chính hãng</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="phone-stage" aria-hidden="true">
                        <img class="phone-image" src="~/assets/phones/iphone-17.svg" alt="iPhone" />

                        <div class="floating-card">
                            <span class="card-label">Member perks</span>
                            <strong>Fast lane</strong>
                            <small>Ưu đãi thành viên &amp; giao hàng nhanh.</small>
                        </div>
                    </div>
                </div>
            </section>

            <section class="auth-panel" aria-label="Form đăng nhập">
                <div class="auth-card">
                    <div class="auth-header">
                        <span class="eyebrow">AURA ACCESS</span>
                        <h1>Chào mừng trở lại.</h1>
                        <p class="subheading">Đăng nhập để tiếp tục trải nghiệm mua sắm tại AURA PHONE.</p>
                    </div>

                    <form id="loginForm" method="post" novalidate>
                        <div class="field">
                            <label for="email">Email</label>
                            <div class="input-wrap" data-for="email">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6.5h16v11H4zM4 7l8 6 8-6" /></svg>
                                <input id="email" name="email" type="email" placeholder="you@example.com" autocomplete="email" aria-label="Email" required />
                            </div>
                            <div class="error-text" id="emailError" aria-live="polite"></div>
                        </div>

                        <div class="field">
                            <label for="password">Mật khẩu</label>
                            <div class="input-wrap" data-for="password">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 10V7.8A5 5 0 0 1 12 3a5 5 0 0 1 5 4.8V10M6 10h12v10H6z" /></svg>
                                <input id="password" name="password" type="password" placeholder="Nhập mật khẩu" autocomplete="current-password" aria-label="Mật khẩu" required />
                                <button class="password-toggle" type="button" data-target="password" aria-label="Hiển thị mật khẩu" aria-pressed="false">
                                    <svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12zm10 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" /></svg>
                                    <svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true" style="display:none;"><path d="M3 3l18 18M10.6 10.6A3 3 0 0 0 13.4 13.4M9.1 5.6A10.7 10.7 0 0 1 12 5c6.5 0 10 7 10 7a17.3 17.3 0 0 1-4.2 5.2M6.2 6.2A15.7 15.7 0 0 0 2 12s3.5 7 10 7a10.6 10.6 0 0 0 5.5-1.6" /></svg>
                                </button>
                            </div>
                            <div class="error-text" id="passwordError" aria-live="polite"></div>
                        </div>

                        <div class="helper-row">
                            <label class="remember" for="rememberMe">
                                <input id="rememberMe" name="rememberMe" type="checkbox" />
                                <span>Ghi nhớ đăng nhập</span>
                            </label>

                            <a class="meta-link" href="#" aria-label="Quên mật khẩu">Quên mật khẩu?</a>
                        </div>

                        <button class="primary-btn" type="submit">
                            <span>Đăng nhập</span>
                        </button>

                        <div class="divider" aria-hidden="true"><span>hoặc tiếp tục với</span></div>

                        <button class="secondary-btn" type="button" aria-label="Tiếp tục với Google">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.2A9.2 9.2 0 0 1 12 21a9 9 0 1 1 0-18 8.7 8.7 0 0 1 6.2 2.5l-2.5 2.4A5.3 5.3 0 0 0 12 6.1a5.9 5.9 0 0 0 0 11.8A5.3 5.3 0 0 0 17.1 15h-5v-3h9.9z" /></svg>
                            <span>Tiếp tục với Google</span>
                        </button>

                        <div class="alt-action">
                            Chưa có tài khoản?
                            <a asp-page="/Register">Đăng ký ngay</a>
                        </div>
                    </form>
                </div>
            </section>
        </main>
    </div>

    <script>
        (function () {
            const form = document.getElementById('loginForm');
            const emailInput = document.getElementById('email');
            const passwordInput = document.getElementById('password');
            const emailWrap = document.querySelector('[data-for="email"]');
            const passwordWrap = document.querySelector('[data-for="password"]');

            const setFieldError = function (input, wrap, message) {
                const errorElement = document.getElementById(input.id + 'Error');
                if (errorElement) {
                    errorElement.textContent = message || '';
                }
                if (wrap) {
                    wrap.classList.toggle('invalid', Boolean(message));
                }
                input.setAttribute('aria-invalid', Boolean(message) ? 'true' : 'false');
            };

            const validateEmail = function () {
                const value = emailInput.value.trim();
                if (!value) {
                    setFieldError(emailInput, emailWrap, 'Email là bắt buộc.');
                    return false;
                }
                const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!emailPattern.test(value)) {
                    setFieldError(emailInput, emailWrap, 'Email không hợp lệ.');
                    return false;
                }
                setFieldError(emailInput, emailWrap, '');
                return true;
            };

            const validatePassword = function () {
                const value = passwordInput.value;
                if (!value) {
                    setFieldError(passwordInput, passwordWrap, 'Mật khẩu là bắt buộc.');
                    return false;
                }
                if (value.length < 8) {
                    setFieldError(passwordInput, passwordWrap, 'Mật khẩu phải có ít nhất 8 ký tự.');
                    return false;
                }
                setFieldError(passwordInput, passwordWrap, '');
                return true;
            };

            emailInput.addEventListener('input', validateEmail);
            passwordInput.addEventListener('input', validatePassword);

            document.querySelectorAll('.password-toggle').forEach(function (button) {
                button.addEventListener('click', function () {
                    const targetId = button.getAttribute('data-target');
                    const input = document.getElementById(targetId);
                    const isPassword = input.type === 'password';

                    input.type = isPassword ? 'text' : 'password';
                    button.setAttribute('aria-pressed', String(isPassword));
                    button.setAttribute('aria-label', isPassword ? 'Ẩn mật khẩu' : 'Hiển thị mật khẩu');

                    const eyeOpen = button.querySelector('.eye-open');
                    const eyeClosed = button.querySelector('.eye-closed');

                    if (isPassword) {
                        eyeOpen.style.display = 'none';
                        eyeClosed.style.display = 'block';
                    } else {
                        eyeOpen.style.display = 'block';
                        eyeClosed.style.display = 'none';
                    }
                });
            });

            form.addEventListener('submit', function (event) {
                event.preventDefault();
                const validEmail = validateEmail();
                const validPassword = validatePassword();

                if (validEmail && validPassword) {
                    form.submit();
                }
            });
        })();
    </script>
</body>
</html>
